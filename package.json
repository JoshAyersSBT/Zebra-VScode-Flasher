{
  "name": "zebra-vscode-flasher",
  "displayName": "Zebra MicroPython",
  "description": "PlatformIO-style VS Code extension for ZebraBot MicroPython setup, projects, flashing, deployment, and serial monitoring.",
  "version": "0.0.5",
  "publisher": "zebra-robotics",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:zebraExplorer",
    "onCommand:zebra.refreshExplorer",
    "onCommand:zebra.projectSetup",
    "onCommand:zebra.initProject",
    "onCommand:zebra.initializeProject",
    "onCommand:zebra.projectStatus",
    "onCommand:zebra.checkProject",
    "onCommand:zebra.setupToolchain",
    "onCommand:zebra.installPython",
    "onCommand:zebra.refreshDriverCache",
    "onCommand:zebra.refreshRobotDriverCache",
    "onCommand:zebra.installRobotDrivers",
    "onCommand:zebra.detectSerialPort",
    "onCommand:zebra.deployProject",
    "onCommand:zebra.flashFirmware",
    "onCommand:zebra.resetDevice",
    "onCommand:zebra.openSerialMonitor",
    "onCommand:zebra.openDriverHelp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zebra",
          "title": "Zebra",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "zebra": [
        {
          "id": "zebraExplorer",
          "name": "Zebra Project"
        }
      ]
    },
    "commands": [
      {
        "command": "zebra.refreshExplorer",
        "title": "Zebra: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "zebra.projectSetup",
        "title": "Zebra: Project Setup",
        "icon": "$(gear)"
      },
      {
        "command": "zebra.initProject",
        "title": "Zebra: Initialize Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "zebra.initializeProject",
        "title": "Zebra: Initialize Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "zebra.projectStatus",
        "title": "Zebra: Project Status",
        "icon": "$(info)"
      },
      {
        "command": "zebra.checkProject",
        "title": "Zebra: Check Python Syntax",
        "icon": "$(check)"
      },
      {
        "command": "zebra.setupToolchain",
        "title": "Zebra: Setup Toolchain",
        "icon": "$(tools)"
      },
      {
        "command": "zebra.installPython",
        "title": "Zebra: Install Python",
        "icon": "$(cloud-download)"
      },
      {
        "command": "zebra.refreshDriverCache",
        "title": "Zebra: Refresh Robot Driver Cache",
        "icon": "$(sync)"
      },
      {
        "command": "zebra.refreshRobotDriverCache",
        "title": "Zebra: Refresh Robot Driver Cache",
        "icon": "$(sync)"
      },
      {
        "command": "zebra.installRobotDrivers",
        "title": "Zebra: Install Robot Drivers into Project",
        "icon": "$(file-submodule)"
      },
      {
        "command": "zebra.detectSerialPort",
        "title": "Zebra: Detect ESP32 Serial Port",
        "icon": "$(plug)"
      },
      {
        "command": "zebra.deployProject",
        "title": "Zebra: Deploy Project to ESP32",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "zebra.flashFirmware",
        "title": "Zebra: Flash MicroPython Firmware",
        "icon": "$(zap)"
      },
      {
        "command": "zebra.resetDevice",
        "title": "Zebra: Reset Device",
        "icon": "$(debug-restart)"
      },
      {
        "command": "zebra.openSerialMonitor",
        "title": "Zebra: Open Serial Monitor",
        "icon": "$(terminal)"
      },
      {
        "command": "zebra.openDriverHelp",
        "title": "Zebra: Open USB UART Driver Help",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zebra.refreshExplorer",
          "when": "view == zebraExplorer",
          "group": "navigation"
        },
        {
          "command": "zebra.projectSetup",
          "when": "view == zebraExplorer",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "zebra.deployProject",
          "when": "resourceLangId == python",
          "group": "navigation@10"
        },
        {
          "command": "zebra.openSerialMonitor",
          "when": "resourceLangId == python",
          "group": "navigation@11"
        }
      ],
      "explorer/context": [
        {
          "command": "zebra.deployProject",
          "when": "zebra.projectActive",
          "group": "zebra@1"
        },
        {
          "command": "zebra.checkProject",
          "when": "zebra.projectActive",
          "group": "zebra@2"
        },
        {
          "command": "zebra.projectSetup",
          "group": "zebra@3"
        }
      ]
    },
    "configuration": {
      "title": "Zebra MicroPython",
      "properties": {
        "zebra.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional Python executable used to create the extension-managed Zebra toolchain virtual environment. Leave empty to auto-detect or install Python 3."
        },
        "zebra.port": {
          "type": "string",
          "default": "AUTO",
          "description": "Serial port to use for mpremote/esptool. Use AUTO to detect."
        },
        "zebra.flashBaud": {
          "type": "number",
          "default": 460800,
          "description": "Baud rate used for esptool firmware flashing."
        },
        "zebra.runtimePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to runtime main.py and robot/ folder. Defaults to extension resources/runtime, or zebra.json runtimePath."
        },
        "zebra.driverCachePath": {
          "type": "string",
          "default": "",
          "description": "Optional local path containing robot/ drivers. Initialize Project uses this before fetching from the repo."
        },
        "zebra.driverRepoUrl": {
          "type": "string",
          "default": "https://github.com/JoshAyersSBT/Zebra_SOL_Flasher.git",
          "description": "Repository used to populate the local Zebra robot driver cache when robot/ is not already cached."
        },
        "zebra.driverRepoBranch": {
          "type": "string",
          "default": "",
          "description": "Optional branch or tag to use when cloning zebra.driverRepoUrl. Empty uses the repo default branch."
        },
        "zebra.serialMonitorBaud": {
          "type": "number",
          "default": 115200,
          "description": "Baud rate used for the serial monitor terminal."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node test/run-unit-tests.js",
    "test:vscode": "npm run compile && node test/run-vscode-smoke.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.92.0",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.5.4"
  }
}
