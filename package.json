{
  "name": "zebra-vscode-flasher",
  "displayName": "Zebra MicroPython",
  "description": "PlatformIO-style VS Code extension for ZebraBot MicroPython setup, projects, flashing, deployment, and serial monitoring.",
  "version": "0.0.16",
  "publisher": "zebra-robotics",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:zebraExplorer",
    "onCommand:zebra.refreshExplorer",
    "onCommand:zebra.welcome",
    "onCommand:zebra.projectSetup",
    "onCommand:zebra.initProject",
    "onCommand:zebra.initializeProject",
    "onCommand:zebra.projectStatus",
    "onCommand:zebra.checkProject",
    "onCommand:zebra.setupToolchain",
    "onCommand:zebra.setupNativeToolchain",
    "onCommand:zebra.installPython",
    "onCommand:zebra.refreshDriverCache",
    "onCommand:zebra.refreshRobotDriverCache",
    "onCommand:zebra.checkDriverCacheUpdates",
    "onCommand:zebra.installRobotDrivers",
    "onCommand:zebra.createUserMainFromExample",
    "onCommand:zebra.detectSerialPort",
    "onCommand:zebra.deployProject",
    "onCommand:zebra.flashFirmware",
    "onCommand:zebra.resetDevice",
    "onCommand:zebra.openSerialMonitor",
    "onCommand:zebra.openDriverHelp",
    "onCommand:zebra.openDriverDocs",
    "onCommand:zebra.openSimulator"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zebra",
          "title": "Zebra",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "zebra": [
        {
          "id": "zebraExplorer",
          "name": "Zebra Project"
        }
      ]
    },
    "commands": [
      {
        "command": "zebra.refreshExplorer",
        "title": "Zebra: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "zebra.welcome",
        "title": "Zebra: Welcome",
        "icon": "$(home)"
      },
      {
        "command": "zebra.projectSetup",
        "title": "Zebra: Project Setup",
        "icon": "$(gear)"
      },
      {
        "command": "zebra.initProject",
        "title": "Zebra: Initialize Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "zebra.initializeProject",
        "title": "Zebra: Initialize Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "zebra.projectStatus",
        "title": "Zebra: Project Status",
        "icon": "$(info)"
      },
      {
        "command": "zebra.checkProject",
        "title": "Zebra: Check Python Syntax",
        "icon": "$(check)"
      },
      {
        "command": "zebra.setupToolchain",
        "title": "Zebra: Setup Toolchain",
        "icon": "$(tools)"
      },
      {
        "command": "zebra.setupNativeToolchain",
        "title": "Zebra: Setup Native C Firmware Toolchain",
        "icon": "$(terminal-linux)"
      },
      {
        "command": "zebra.installPython",
        "title": "Zebra: Install Python",
        "icon": "$(cloud-download)"
      },
      {
        "command": "zebra.refreshDriverCache",
        "title": "Zebra: Refresh Robot Driver Cache",
        "icon": "$(sync)"
      },
      {
        "command": "zebra.refreshRobotDriverCache",
        "title": "Zebra: Refresh Robot Driver Cache",
        "icon": "$(sync)"
      },
      {
        "command": "zebra.checkDriverCacheUpdates",
        "title": "Zebra: Check Robot Driver Cache Updates",
        "icon": "$(cloud-download)"
      },
      {
        "command": "zebra.installRobotDrivers",
        "title": "Zebra: Install Robot Drivers into Project",
        "icon": "$(file-submodule)"
      },
      {
        "command": "zebra.createUserMainFromExample",
        "title": "Zebra: Create user_main.py from Example",
        "icon": "$(file-code)"
      },
      {
        "command": "zebra.detectSerialPort",
        "title": "Zebra: Detect ESP32 Serial Port",
        "icon": "$(plug)"
      },
      {
        "command": "zebra.deployProject",
        "title": "Zebra: Deploy Project to ESP32",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "zebra.flashFirmware",
        "title": "Zebra: Flash MicroPython Firmware",
        "icon": "$(zap)"
      },
      {
        "command": "zebra.resetDevice",
        "title": "Zebra: Reset Device",
        "icon": "$(debug-restart)"
      },
      {
        "command": "zebra.openSerialMonitor",
        "title": "Zebra: Open Serial Monitor",
        "icon": "$(terminal)"
      },
      {
        "command": "zebra.openDriverHelp",
        "title": "Zebra: Open USB UART Driver Help",
        "icon": "$(link-external)"
      },
      {
        "command": "zebra.openDriverDocs",
        "title": "Zebra: Open Robot Driver Docs",
        "icon": "$(book)"
      },
      {
        "command": "zebra.openSimulator",
        "title": "Zebra: Open Robot Simulator",
        "icon": "$(debug-start)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zebra.refreshExplorer",
          "when": "view == zebraExplorer",
          "group": "navigation"
        },
        {
          "command": "zebra.projectSetup",
          "when": "view == zebraExplorer",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "zebra.deployProject",
          "when": "resourceLangId == python",
          "group": "navigation@10"
        },
        {
          "command": "zebra.openSerialMonitor",
          "when": "resourceLangId == python",
          "group": "navigation@11"
        }
      ],
      "explorer/context": [
        {
          "command": "zebra.deployProject",
          "when": "zebra.projectActive",
          "group": "zebra@1"
        },
        {
          "command": "zebra.checkProject",
          "when": "zebra.projectActive",
          "group": "zebra@2"
        },
        {
          "command": "zebra.projectSetup",
          "group": "zebra@3"
        },
        {
          "command": "zebra.openSimulator",
          "when": "zebra.projectActive",
          "group": "zebra@4"
        }
      ]
    },
    "configuration": {
      "title": "Zebra MicroPython",
      "properties": {
        "zebra.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional Python executable used to create the extension-managed Zebra toolchain virtual environment. Leave empty to auto-detect or install Python 3."
        },
        "zebra.port": {
          "type": "string",
          "default": "AUTO",
          "description": "Serial port to use for mpremote/esptool. Use AUTO to detect."
        },
        "zebra.flashBaud": {
          "type": "number",
          "default": 460800,
          "description": "Baud rate used for esptool firmware flashing."
        },
        "zebra.firmwareUrl": {
          "type": "string",
          "default": "https://micropython.org/resources/firmware/ESP32_GENERIC-20260406-v1.28.0.bin",
          "description": "ESP32 MicroPython firmware URL used by Zebra: Flash MicroPython Firmware when auto-collecting firmware."
        },
        "zebra.nativeBuildRoot": {
          "type": "string",
          "default": "~/zbot-fw",
          "description": "Linux/WSL directory used for native Zebra MicroPython firmware build dependencies."
        },
        "zebra.wslFlasherUsername": {
          "type": "string",
          "default": "flasher",
          "description": "Linux username Zebra creates and sets as the default user in its WSL Debian setup."
        },
        "zebra.wslFlasherPassword": {
          "type": "string",
          "default": "flasher",
          "description": "Password assigned to zebra.wslFlasherUsername during Zebra WSL Debian setup."
        },
        "zebra.runtimePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to runtime main.py and robot/ folder. Defaults to zebra.json runtimePath, then the Zebra driver repo cache, then extension resources/runtime."
        },
        "zebra.driverCachePath": {
          "type": "string",
          "default": "",
          "description": "Optional local path containing robot/ drivers. Initialize Project uses this before fetching from the repo."
        },
        "zebra.driverRepoUrl": {
          "type": "string",
          "default": "https://github.com/JoshAyersSBT/ZbotDriver.git",
          "description": "Repository used to populate the local Zebra robot driver cache when robot/ is not already cached."
        },
        "zebra.driverRepoBranch": {
          "type": "string",
          "default": "codex/C-Core-modules",
          "description": "Branch or tag to use when cloning zebra.driverRepoUrl. Defaults to the C-core modules driver branch."
        },
        "zebra.serialMonitorBaud": {
          "type": "number",
          "default": 115200,
          "description": "Baud rate used for the serial monitor terminal."
        },
        "zebra.deployTransport": {
          "type": "string",
          "enum": ["serial", "ble", "wifi"],
          "default": "serial",
          "description": "Transport used by Zebra: Deploy Project. Serial deploys the full staged runtime with mpremote. Wi-Fi and BLE upload only the staged user_main.py."
        },
        "zebra.wifiUrl": {
          "type": "string",
          "default": "http://192.168.4.1:8080",
          "description": "Robot Wi-Fi code server URL used for Zebra user program uploads."
        },
        "zebra.wifiToken": {
          "type": "string",
          "default": "",
          "description": "Optional token sent to the Zebra Wi-Fi code server."
        },
        "zebra.wifiTimeout": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 120,
          "description": "HTTP timeout in seconds for Wi-Fi user program uploads."
        },
        "zebra.bleName": {
          "type": "string",
          "default": "ZebraBot",
          "description": "BLE advertised name used for Zebra user program uploads."
        },
        "zebra.bleChunkSize": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 128,
          "description": "Raw user program bytes per BLE upload chunk. The default is conservative for 20-byte BLE writes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node test/run-unit-tests.js",
    "test:vscode": "npm run compile && node test/run-vscode-smoke.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.92.0",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.5.4"
  }
}
